{
  "name": "fancy-hn",
  "type": "module",
  "version": "1.5.0",
  "packageManager": "pnpm@11.23.0",
  "description": "A browser extension that replaces the Hacker News UI with a cleaner, more modern design.",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "dev": "pnpm build:anti-fouc && pnpm build:settings && pnpm build:background && BUILD_TARGET=content vite build --watch",
    "build": "pnpm build:content && pnpm build:settings && pnpm build:background",
    "build:content": "rm -rf dist/content && BUILD_TARGET=content vite build && pnpm build:anti-fouc",
    "build:anti-fouc": "BUILD_TARGET=anti-fouc vite build",
    "build:settings": "rm -rf dist/settings dist/settings.html && BUILD_TARGET=settings vite build",
    "build:background": "rm -rf dist/background && BUILD_TARGET=background vite build",
    "package": "node scripts/package-extension.mjs",
    "concepts:dev": "vite --config concepts/vite.config.ts",
    "concepts:build": "vite build --config concepts/vite.config.ts",
    "concepts:preview": "vite preview --config concepts/vite.config.ts",
    "check": "pnpm check:quality && pnpm build",
    "check:quality": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@iconify-json/material-symbols": "^1.2.90",
    "@vueuse/core": "^14.4.0",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.10.4",
    "vue": "^3.5.42",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@types/chrome": "^0.1.43",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "sass": "^1.104.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2",
    "vitest": "4.1.2",
    "vue-tsc": "^3.3.11"
  }
}
